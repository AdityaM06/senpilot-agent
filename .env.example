# Values are examples. Keep the real .env and credential files out of Git.
AGENT_EMAIL=
MODEL_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
# Optional: set MODEL_PROVIDER=openai to use these instead of Vertex AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
# Optional, for the separate evaluation command:
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_OAUTH_CLIENT_FILE=credentials/oauth-client.json
GOOGLE_OAUTH_TOKEN_FILE=credentials/gmail-token.json
# A separate Google Cloud principal with subscription access; or use Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=
PUBSUB_TOPIC=projects/YOUR_PROJECT/topics/gmail-events
PUBSUB_SUBSCRIPTION=projects/YOUR_PROJECT/subscriptions/gmail-events-worker
AGENT_DATA_DIR=var
HEADLESS=true
# Optional: use an installed browser, e.g. chrome, on an older development OS.
BROWSER_CHANNEL=
ATTACHMENT_BUDGET_BYTES=18000000
MAX_MESSAGE_BYTES=24000000
